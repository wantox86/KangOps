# Base URL of the KangOps server, reachable from this host. No trailing slash needed.
# LAN-only by default: KangOps has no built-in auth (see docs/reverse-proxy-and-auth.md), so
# this should be a private address or go through the same reverse proxy as the dashboard.
KANGOPS_URL=http://192.168.50.131:8085

# The token returned exactly once by POST /api/v1/agents on the KangOps server. It both
# authenticates this agent and identifies which host it reports as. Treat it as a credential:
# this file should be 0600 and is never committed.
KANGOPS_AGENT_TOKEN=replace-me

# How often to report, in seconds. The server marks an agent unreachable after 3 missed
# intervals, so this also sets how fast an outage is noticed.
AGENT_INTERVAL_SECONDS=30

# Optional: what to call this host in reports. Defaults to the container's view of `hostname`.
# AGENT_HOSTNAME=
