# Copy to .env and adjust. Only non-secret settings live here -- webhook alert config, backup
# targets, and registry-check settings are all configured at runtime via the API/UI (stored in
# the settings table / their own tables), not env vars, since they're user-editable without a
# redeploy. See CLAUDE.md's Milestone 4 notes.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=/data/kangops.sqlite
LOG_LEVEL=info

# Milestone 2: Docker read adapter + collection loop.
# DOCKER_MODE=fixture replays recorded sample data (no daemon needed) -- useful for a quick
# local demo. docker-compose.yml overrides this to DOCKER_MODE=socket + DOCKER_HOST pointing at
# the docker-socket-proxy sidecar for a real deployment; do not point DOCKER_HOST at a raw
# docker.sock mount directly (see README's Docker socket security section).
DOCKER_MODE=fixture
DOCKER_HOST=tcp://docker-socket-proxy:2375
COLLECTOR_INTERVAL_MS=20000
COLLECTOR_TIMEOUT_MS=5000
COLLECTOR_RETRIES=2

# Milestone 8: container control (start/stop/restart from the dashboard). Off by default --
# there is currently NO authentication in front of this API/UI, so enabling this means anyone
# who can reach the dashboard can start/stop/restart containers on this host. docker-compose.yml
# sets this to true for this deployment (a deliberate choice, see CLAUDE.md's Milestone 8
# entry); leave it false here for local/fixture dev.
CONTAINER_CONTROL_ENABLED=false
DOCKER_CONTROL_HOST=tcp://docker-socket-proxy-control:2375
